<!doctype html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/main.css') }}">
    <title>Калькулятор</title>
</head>
<body>
    <div class="card">
        <h2>Калькулятор сложного процента</h2>
        <form method="POST" class="calc-form">
            <input name="p" placeholder="Начальная сумма" type="number" step="any" required>
            <input name="r" placeholder="Годовая ставка (%)" type="number" step="any" required>
            <input name="t" placeholder="Количество лет" type="number" step="any" required>
            <button type="submit">Рассчитать</button>
        </form>

        {% if result is not none %}
            <p class="result"><strong>Итоговая сумма:</strong> {{ result }}</p>
        {% endif %}
    </div>
</body>
</html>